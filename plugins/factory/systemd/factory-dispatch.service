[Unit]
Description=Factory dispatcher — one dispatch over Trello, GitHub and the factory workers

[Service]
Type=oneshot
# FACTORY_SLACK_TOKEN (a bot token), TRELLO_API_KEY, TRELLO_TOKEN. chmod 600; never in a repo.
EnvironmentFile=%h/.config/factory/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The plugin runs from the marketplace clone, like nightly-backlog's runner.
ExecStart=%h/.claude/plugins/marketplaces/redsteep/plugins/factory/scripts/factory-dispatch %h/Projects/Rhumbler
TimeoutStartSec=45min
