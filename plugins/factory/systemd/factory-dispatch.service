[Unit]
Description=Factory dispatcher — one dispatch over Trello, GitHub and the factory workers

[Service]
Type=oneshot
# Optional: FACTORY_SLACK_TOKEN (a bot token), TRELLO_API_KEY, TRELLO_TOKEN — chmod 600, never in a
# repo. Any of them missing here is read from the repo's .env; without a Slack token, no DMs.
EnvironmentFile=-%h/.config/factory/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The plugin runs from the marketplace clone, like nightly-backlog's runner.
# Replace REPO_PATH with the repo's absolute path; and set PATH to the shell PATH your workers
# need (node, poetry, … — they inherit it).
ExecStart=%h/.claude/plugins/marketplaces/redsteep/plugins/factory/scripts/factory-dispatch REPO_PATH
TimeoutStartSec=45min
